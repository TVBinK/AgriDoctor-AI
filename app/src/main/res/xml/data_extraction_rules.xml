<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted database from cloud backup -->
        <exclude domain="database" path="agridoctor_database" />
        <exclude domain="database" path="agridoctor_database-shm" />
        <exclude domain="database" path="agridoctor_database-wal" />
        
        <!-- Exclude database password from cloud backup -->
        <exclude domain="sharedpref" path="database_password_prefs.xml" />
        
        <!-- Exclude diagnose images from cloud backup -->
        <exclude domain="file" path="diagnose_images/" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>