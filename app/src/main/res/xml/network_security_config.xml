<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cấu hình mặc định: chỉ cho phép HTTPS với system certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Cấu hình cho development server với self-signed certificate -->
    <!-- Cho phép trust user certificates (self-signed) cho development server -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">192.168.34.116</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.28.1</domain>
        <trust-anchors>
            <!-- Trust system certificates -->
            <certificates src="system" />
            <!-- Trust user-installed certificates (self-signed certificates) -->
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>


